{
    "swagger": "2.0",
    "info": {
        "title": "FSC Finance App API",
        "description": "API for FSC Finance App that allows users to manage their finances.",
        "version": "1.0.0"
    },
    "paths": {
        "/api/users": {
            "post": {
                "summary": "Create a new user",
                "tags": ["User"],
                "parameters": [
                    {
                        "name": "body",
                        "required": true,
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/CreateUserParams"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "User created successfully",
                        "schema": {
                            "$ref": "#/definitions/User"
                        }
                    },
                    "400": {
                        "description": "Invalid params",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "example": "Invalis params"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/InternalServerErrorResponse"
                        }
                    }
                }
            }
        },

        "/api/users/{userId}": {
            "get": {
                "summary": "Get user by ID",
                "tags": ["User"],
                "parameters": [
                    {
                        "name": "userId",
                        "required": true,
                        "in": "path",
                        "type": "string",
                        "description": "ID of user to get"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User found",
                        "schema": {
                            "$ref": "#/definitions/User"
                        }
                    },
                    "404": {
                        "description": "User not found",
                        "schema": {
                            "$ref": "#/definitions/UserNotFoundResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/InternalServerErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "summary": "Delete user by ID",
                "tags": ["User"],
                "parameters": [
                    {
                        "name": "userId",
                        "required": true,
                        "in": "path",
                        "type": "string",
                        "description": "ID of the user to delete"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User deleted successfully",
                        "schema": {
                            "$ref": "#/definitions/User"
                        }
                    },
                    "404": {
                        "description": "User not found",
                        "schema": {
                            "$ref": "#/definitions/UserNotFoundResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/InternalServerErrorResponse"
                        }
                    }
                }
            }
        }
    },

    "definitions": {
        "CreateUserParams": {
            "type": "object",
            "properties": {
                "first_name": {
                    "type": "string",
                    "example": "Jhon"
                },
                "last_name": {
                    "type": "string",
                    "example": "Dom"
                },
                "email": {
                    "type": "string",
                    "example": "jhon@dom.com"
                },
                "password": {
                    "type": "string",
                    "example": "password"
                }
            }
        },

        "User": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "example": "e7f1cecc-da48-4999-bd14-5e0767325a43"
                },
                "first_name": {
                    "type": "string",
                    "example": "Jhon"
                },
                "last_name": {
                    "type": "string",
                    "example": "Dom"
                },
                "email": {
                    "type": "string",
                    "example": "jhon@dom.com"
                },
                "password": {
                    "type": "string",
                    "example": "password"
                }
            }
        },

        "UserNotFoundResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "User not found"
                }
            }
        },

        "InternalServerErrorResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Internal server error"
                }
            }
        }
    }
}
